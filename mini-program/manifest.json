{
  "name": "自主接单平台",
  "appid": "",
  "description": "通用任务接单平台",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    "appid": "{WECHAT_APPID}",
    "setting": {
      "urlCheck": false,
      "es6": true,
