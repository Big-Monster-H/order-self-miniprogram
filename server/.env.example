# ==========================================
# 任务接单平台 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# ==========================================

# 数据库类型: sqlite (本地开发) 或 mysql (生产)
DB_TYPE=sqlite

# MySQL 配置 (DB_TYPE=mysql 时生效)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=task_platform

# JWT 密钥 (生产环境请使用随机字符串)
JWT_SECRET=change-me-to-random-string
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3001

# 微信小程序配置
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret

# 微信支付配置 (可选)
WX_MCHID=
WX_PAY_KEY=
WX_PAY_CERT_PATH=
WX_PAY_KEY_PATH=
WX_NOTIFY_URL=

# 微信模板消息ID (可选)
WX_TEMPLATE_ORDER_NEW=
WX_TEMPLATE_ORDER_ACCEPT=
WX_TEMPLATE_ORDER_COMPLETE=
WX_TEMPLATE_REFUND=

# 平台抽佣比例 (%)
PLATFORM_COMMISSION_RATE=8

# 接单者保证金 (单位: 分, 50000 = 500元)
DEPOSIT_AMOUNT=50000

# 上传目录
UPLOAD_DIR=./uploads
